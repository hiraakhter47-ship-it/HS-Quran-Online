# Copy to .env.local for local development, and add the same variable in
# Vercel: Project Settings -> Environment Variables.
#
# Web3Forms access key for the Book a Free Demo form. Create one at https://web3forms.com
# using the email address that should receive registrations.
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: the site's public address (only needed for a custom domain; on Vercel the
# production domain is detected automatically). Used for canonical links, sitemap and social previews.
# SITE_URL=https://www.example.com
